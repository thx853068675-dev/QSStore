{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "metadata": [{ "name": "ohos.arkui.UIMaterial.state", "value": "enable" }],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "launchType": "singleton",
        "backgroundModes": ["dataTransfer"],
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          },
          {
            "entities": [
              "entity.system.default"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "file",
                "type": "openharmony.hap",
                "linkFeature": "FileOpen",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "type": "openharmony.package",
                "linkFeature": "FileOpen",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "type": "com.tonghongxiang.hapstore.app",
                "linkFeature": "FileOpen",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "type": "general.zip-archive",
                "linkFeature": "FileOpen",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "type": "general.tar-archive",
                "linkFeature": "FileOpen",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "type": "org.gnu.gnu-tar-archive",
                "linkFeature": "FileOpen",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "type": "org.gnu.gnu-zip-archive",
                "linkFeature": "FileOpen",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "type": "org.gnu.gnu-zip-tar-archive",
                "linkFeature": "FileOpen",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "type": "general.bz2-archive",
                "linkFeature": "FileOpen",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "type": "com.rarlab.rar-archive",
                "linkFeature": "FileOpen",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "type": "org.7-zip.7-zip-archive",
                "linkFeature": "FileOpen",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "type": "com.tonghongxiang.hapstore.extra-archive",
                "linkFeature": "FileOpen",
                "maxFileSupported": 1
              }
            ]
          },
          {
            // Chat clients can pass a MIME instead of a UTD. Petrelgram sends
            // application/binary for HAP files. Do not use application/* or */*:
            // ordinary documents should keep their existing open handlers.
            // Generic binary files still require a supported filename and pass
            // the same read-only package inspection before installation.
            "entities": ["entity.system.default"],
            "actions": ["ohos.want.action.viewData"],
            "uris": [
              { "scheme": "file", "type": "application/binary", "linkFeature": "FileOpen", "maxFileSupported": 1 },
              { "scheme": "file", "type": "application/octet-stream", "linkFeature": "FileOpen", "maxFileSupported": 1 },
              { "scheme": "file", "type": "application/vnd.harmonyos.hap", "linkFeature": "FileOpen", "maxFileSupported": 1 },
              { "scheme": "file", "type": "application/x-hap", "linkFeature": "FileOpen", "maxFileSupported": 1 },
              { "scheme": "file", "type": "application/vnd.harmonyos.app", "linkFeature": "FileOpen", "maxFileSupported": 1 },
              { "scheme": "file", "type": "application/zip", "linkFeature": "FileOpen", "maxFileSupported": 1 },
              { "scheme": "file", "type": "application/x-zip-compressed", "linkFeature": "FileOpen", "maxFileSupported": 1 },
              { "scheme": "file", "type": "application/x-7z-compressed", "linkFeature": "FileOpen", "maxFileSupported": 1 },
              { "scheme": "file", "type": "application/vnd.rar", "linkFeature": "FileOpen", "maxFileSupported": 1 },
              { "scheme": "file", "type": "application/x-rar-compressed", "linkFeature": "FileOpen", "maxFileSupported": 1 },
              { "scheme": "file", "type": "application/x-tar", "linkFeature": "FileOpen", "maxFileSupported": 1 },
              { "scheme": "file", "type": "application/gzip", "linkFeature": "FileOpen", "maxFileSupported": 1 },
              { "scheme": "file", "type": "application/x-gzip", "linkFeature": "FileOpen", "maxFileSupported": 1 },
              { "scheme": "file", "type": "application/x-bzip2", "linkFeature": "FileOpen", "maxFileSupported": 1 },
              { "scheme": "file", "type": "application/x-xz", "linkFeature": "FileOpen", "maxFileSupported": 1 },
              { "scheme": "file", "type": "application/x-lzma", "linkFeature": "FileOpen", "maxFileSupported": 1 }
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.GET_NETWORK_INFO" },
      { "name": "ohos.permission.KEEP_BACKGROUND_RUNNING" },
      { "name": "ohos.permission.DETECT_GESTURE" },
      {
        // 查询本机已安装版本。SDK 声明（@ohos.bundle.bundleManager.d.ts:1389）：
        //   @permission ohos.permission.GET_BUNDLE_INFO_PRIVILEGED
        //               or ohos.permission.GET_BUNDLE_INFO
        // PRIVILEGED 是系统级权限，普通应用拿不到；GET_BUNDLE_INFO 是开放权限
        // （system_grant，装上即授予）。不声明它时查询抛 201，而 201 过去被
        // 当成「没装」——外部安装的应用识别不到，有安装记录的一直显示「更新」。
        "name": "ohos.permission.GET_BUNDLE_INFO"
      }
    ]
  }
}
