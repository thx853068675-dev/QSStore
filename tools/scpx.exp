#!/usr/bin/expect -f
# usage: scpx.exp <host> <user> <password> <localfile> <remotepath>
set HOST [lindex $argv 0]
set USER [lindex $argv 1]
set PASS [lindex $argv 2]
set SRC  [lindex $argv 3]
set DST  [lindex $argv 4]
set timeout 120
spawn scp -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/tmp/ts_known_hosts -o LogLevel=ERROR -o ConnectTimeout=15 $SRC $USER@$HOST:$DST
expect {
  -re "(?i)password:" { send "$PASS\r"; exp_continue }
  -re "(?i)are you sure" { send "yes\r"; exp_continue }
  eof
}
catch wait result
exit [lindex $result 3]
