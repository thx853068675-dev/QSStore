#!/usr/bin/expect -f
# usage: sshx.exp <host> <user> <password> <command...>
set HOST [lindex $argv 0]
set USER [lindex $argv 1]
set PASS [lindex $argv 2]
set CMD  [lrange $argv 3 end]
set timeout 60
spawn ssh -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/tmp/ts_known_hosts -o LogLevel=ERROR -o ConnectTimeout=15 $USER@$HOST {*}$CMD
expect {
  -re "(?i)password:" { send "$PASS\r"; exp_continue }
  -re "(?i)are you sure" { send "yes\r"; exp_continue }
  eof
}
catch wait result
exit [lindex $result 3]
