export class I18n {
  private static selected: string = 'zh';

  static language(): string {
    return I18n.selected;
  }

  static setLanguage(value: string): void {
    I18n.selected = value === 'en' ? 'en' : 'zh';
  }

  static sortLabel(key: string): string {
    if (I18n.selected === 'zh') {
      return key === 'downloads' ? '下载' : key === 'new' ? '上架' : '星数';
    }
    return key === 'downloads' ? 'Downloads' : key === 'new' ? 'Newest' : 'Stars';
  }

  static category(value: string): string {
    if (I18n.selected === 'zh' || value.length === 0) return value;
    const hit = CATEGORY.get(value);
    return hit === undefined ? value : hit;
  }

  static t(zh: string): string {
    if (I18n.selected === 'zh') return zh;
    const value = ENGLISH.get(zh);
    return value === undefined ? zh : value;
  }
}

